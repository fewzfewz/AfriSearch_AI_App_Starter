# Copy to .env and fill in. Used by docker compose and read by the API.

# Sign-in: "none" (local, single user) or "supabase" (accounts; needed before going online).
AFRISEARCH_AUTH=none
# From Supabase: Project Settings -> API. The anon key is public by design.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Only for projects still on the legacy JWT secret; leave empty for new projects.
SUPABASE_JWT_SECRET=
# Extra sign-in buttons, e.g. "google" (enable the provider in Supabase too).
AFRISEARCH_AUTH_PROVIDERS=

# Answer models (optional). Without keys, the small local model is used.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AFRISEARCH_DEFAULT_PROVIDER=

# Where the app listens. Keep 127.0.0.1 unless sign-in is on and HTTPS is in front.
AFRISEARCH_BIND=127.0.0.1
