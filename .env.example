# Copy to .env and fill in. Used by docker compose and read by the API.

# Sign-in: "none" (local, single user) or "supabase" (accounts; needed before going online).
AFRISEARCH_AUTH=none
# From Supabase: Project Settings -> API. The anon key is public by design.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Only for projects still on the legacy JWT secret; leave empty for new projects.
SUPABASE_JWT_SECRET=
# Extra sign-in buttons, e.g. "google" (enable the provider in Supabase too).
AFRISEARCH_AUTH_PROVIDERS=

# Answer models (optional). Without keys, the small local model is used.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AFRISEARCH_DEFAULT_PROVIDER=

# Where the app listens. Keep 127.0.0.1 unless sign-in is on and HTTPS is in front.
AFRISEARCH_BIND=127.0.0.1

# --- Production (deploy/docker-compose.prod.yml) ---
AFRISEARCH_DOMAIN=
AFRISEARCH_ORG_NAME=
AFRISEARCH_CONTACT_EMAIL=
# Lets "Delete my account" also remove the Supabase sign-in account. Secret: server only.
SUPABASE_SERVICE_ROLE_KEY=
# Public address of the web app, for links in emails.
AFRISEARCH_APP_URL=
# Email: resend, smtp or log (prints emails in the server log); empty = off.
AFRISEARCH_EMAIL=
AFRISEARCH_EMAIL_FROM=AfriSearch <noreply@example.org>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Prices of models other than Claude Opus 5.5, for cost estimates (USD per million tokens).
AFRISEARCH_MODEL_PRICES=
# Error tracking (sentry.io); the web DSN is public by design.
SENTRY_DSN=
SENTRY_DSN_WEB=
# Limits (0 turns one off)
AFRISEARCH_WORKSPACE_QUOTA_MB=500
AFRISEARCH_ASK_PER_MINUTE=20
AFRISEARCH_ASK_PER_DAY=500
AFRISEARCH_UPLOADS_PER_HOUR=200
